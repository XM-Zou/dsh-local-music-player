{
  "name": "dsh-local-music-player",
  "version": "0.7.1",
  "description": "Local-first music player and playlist manager for the DSH Web UI. · DSH 本地音乐播放器，支持导入、歌单分类与后台播放。",
  "license": "MIT",
  "author": "XM-Zou",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XM-Zou/dsh-local-music-player.git"
  },
  "homepage": "https://github.com/XM-Zou/dsh-local-music-player#readme",
  "bugs": {
    "url": "https://github.com/XM-Zou/dsh-local-music-player/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "music",
    "player",
    "playlist",
    "local-first"
  ],
  "engines": {
    "dsh": ">=0.2.1"
  },
  "scripts": {
    "check": "node scripts/check.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
